<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWindowsForms>true</UseWindowsForms><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SoundpadWeb</AssemblyName><Version>2.41.0</Version><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><DebugType>embedded</DebugType><PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs;harness/**/*.cs"/><FrameworkReference Include="Microsoft.AspNetCore.App"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../docs/licenses/*.txt" Link="Licenses/%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../docs/licenses/*.rtf" Link="Licenses/%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="SoundpadWeb.Tests"/><InternalsVisibleTo Include="SoundpadWeb.Harness"/></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="WebsiteUrl" Value="$(WebsiteUrl)" Condition="'$(WebsiteUrl)' != ''"/></ItemGroup>
  <ItemGroup><FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.13"/><FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="10.0.13"/><FrameworkReference Update="Microsoft.WindowsDesktop.App.WindowsForms" RuntimeFrameworkVersion="10.0.13"/></ItemGroup>
  <!-- 2.36: a desktop app with the Soundpad Web window (WebView2). Only the window's files import WinForms, so the
       implicit WinForms/System.Drawing usings are left out (their Timer, Control and Region names would clash). -->
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" PrivateAssets="all"/></ItemGroup>
  <!-- System.Drawing.Common (icons) comes with the Windows Desktop framework since 2.36, at the same 10.0.13. The
       WebView2 package stays private to the companion (tests and the harness never open the window), and its WPF
       control, which this WinForms app never loads, is left out. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences"><ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'"/></ItemGroup></Target>
<ItemGroup><PackageReference Include="NAudio.Wasapi" Version="3.3.0"/><PackageReference Include="NVorbis" Version="0.10.5"/><PackageReference Include="Whisper.net" Version="1.9.1"/><PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true"/></ItemGroup>
  <!-- Whisper's native DLLs are embedded and written to the data folder on first use, so the companion stays one EXE. -->
  <ItemGroup><EmbeddedResource Include="$(PkgWhisper_net_Runtime)/build/win-x64/*.dll" LogicalName="WhisperNative.%(Filename)%(Extension)" Visible="false"/></ItemGroup></Project>
